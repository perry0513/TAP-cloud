module tap {
//
// Replaying a previously produced ciphertext.
//
// Threat T2 says the adversary may write back "an encrypted state previously
// generated by the client enclave and observed by the adversary".  The two-slot
// storage cannot express that: a rollback overwrites `fresh` with `stale` and
// the overwritten ciphertext disappears from the model state, so no later
// operation can reinstall it.
//
// The history is tracked by `tap_storage_produced`, which `storePS` extends with
// the tag of every ciphertext it writes.  Recording only tags loses nothing:
// a tag binds its ciphertext, so the content is `tag_mem(t)` / `tag_valid_map(t)`
// and need not be stored.  `replay_storage` therefore realizes T2 with no bound
// on how much the adversary retains.
//
procedure [noinline] replay_storage (eid : tap_enclave_id_t, t : tag_t)
  returns (status : enclave_op_result_t)

  //----------------------------------------------------------------------//
  // The status can only be success or failure                            //
  //----------------------------------------------------------------------//
  ensures (status == enclave_op_success || status == enclave_op_failed);

  //----------------------------------------------------------------------//
  // Success/failure conditions                                           //
  //----------------------------------------------------------------------//
  // The adversary can only write back a ciphertext the enclave actually wrote.
  ensures (cpu_enclave_id == tap_null_enc_id &&
            tap_storage_produced[eid][t])
            <==> (status == enclave_op_success);

  //----------------------------------------------------------------------//
  // State updates on success                                             //
  //----------------------------------------------------------------------//
  // The replayed ciphertext replaces whatever is in storage.
  ensures (status == enclave_op_success) ==>
            (tap_storage_mem[eid]        == tag_mem(t) &&
              tap_storage_addr_valid[eid] == tag_valid_map(t) &&
              tap_storage_key[eid]        == tap_storage_produced_key[eid][t] &&
              tap_storage_tag[eid]        == t);
  ensures (status == enclave_op_success) ==>
            (forall (e : tap_enclave_id_t) ::
              (e != eid) ==>
                (tap_storage_mem[e] == old(tap_storage_mem)[e]  &&
                  tap_storage_addr_valid[e] == old(tap_storage_addr_valid)[e] &&
                  tap_storage_key[e] == old(tap_storage_key)[e]   &&
                  tap_storage_tag[e] == old(tap_storage_tag)[e]));

  //----------------------------------------------------------------------//
  // Nothing changes on failure                                           //
  //----------------------------------------------------------------------//
  ensures (status != enclave_op_success ==> tap_storage_mem == old(tap_storage_mem));
  ensures (status != enclave_op_success ==> tap_storage_addr_valid == old(tap_storage_addr_valid));
  ensures (status != enclave_op_success ==> tap_storage_key == old(tap_storage_key));
  ensures (status != enclave_op_success ==> tap_storage_tag == old(tap_storage_tag));

  //----------------------------------------------------------------------//
  // Modifies statements                                                  //
  //----------------------------------------------------------------------//
  modifies tap_storage_mem;
  modifies tap_storage_addr_valid;
  modifies tap_storage_key;
  modifies tap_storage_tag;
{
  status = enclave_op_success;

  if (cpu_enclave_id != tap_null_enc_id ||
      !tap_storage_produced[eid][t]) {
    status = enclave_op_failed;
  } else {
    tap_storage_mem[eid]        = tag_mem(t);
    tap_storage_addr_valid[eid] = tag_valid_map(t);
    tap_storage_key[eid]        = tap_storage_produced_key[eid][t];
    tap_storage_tag[eid]        = t;
  }
}
}
