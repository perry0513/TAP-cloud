module tap {
//
// Tamper data in persistent storage
//
procedure [noinline] tamper_storage (eid : tap_enclave_id_t)
  returns (status : enclave_op_result_t)

  //----------------------------------------------------------------------//
  // The status can only be success or failure                            //
  //----------------------------------------------------------------------//
  ensures (status == enclave_op_success || status == enclave_op_failed);

  //----------------------------------------------------------------------//
  // Success/failure conditions                                           //
  //----------------------------------------------------------------------//
  ensures(cpu_enclave_id == tap_null_enc_id)
            <==> (status == enclave_op_success);

  //----------------------------------------------------------------------//
  // State updates on success                                             //
  //----------------------------------------------------------------------//
  // Key for encoding the data is different the key stored in KMS
  ensures (status == enclave_op_success) ==>
            (tap_storage_key[eid] == null_key_t ||
             (tap_storage_key[eid] != tap_kms_key[eid] &&
              tap_storage_key[eid] != tap_enclave_metadata_key[eid]));
  // The tag is neither a tag the enclave would accept now nor one it could
  // reach by its next store.  (With chained tags "the next tag after t" is the
  // whole family { chain(t, d) : d }, i.e. the tags whose predecessor is t.)
  ensures (status == enclave_op_success) ==>
            (tap_storage_tag[eid] != tap_kms_tag[eid] &&
             tag_prev(tap_storage_tag[eid]) != tap_kms_tag[eid] &&
             tap_storage_tag[eid] != tap_enclave_metadata_tag[eid] &&
             tag_prev(tap_storage_tag[eid]) != tap_enclave_metadata_tag[eid]);
  // Whatever blob is written, its tag binds its content: a tag is carried
  // inside the authenticated ciphertext, so no party -- adversary included --
  // can present a tag/content pair that does not chain.  This costs the
  // adversary nothing, since a blob under a non-client key is rejected by
  // `_load_storage` on the key check regardless of its tag.
  ensures (status == enclave_op_success) ==>
            (tag_mem(tap_storage_tag[eid]) == tap_storage_mem[eid] &&
              tag_valid_map(tap_storage_tag[eid]) == tap_storage_addr_valid[eid]);
  ensures (status == enclave_op_success) ==>
            (forall (e : tap_enclave_id_t) ::
              (e != eid) ==>
                (tap_storage_mem[e] == old(tap_storage_mem)[e]  &&
                  tap_storage_addr_valid[e] == old(tap_storage_addr_valid)[e] &&
                  tap_storage_key[e] == old(tap_storage_key)[e]   &&
                  tap_storage_tag[e] == old(tap_storage_tag)[e]));

  //----------------------------------------------------------------------//
  // Nothing changes on failure                                           //
  //----------------------------------------------------------------------//
  ensures (status != enclave_op_success ==> tap_storage_mem == old(tap_storage_mem));
  ensures (status != enclave_op_success ==> tap_storage_addr_valid == old(tap_storage_addr_valid));
  ensures (status != enclave_op_success ==> tap_storage_key == old(tap_storage_key));
  ensures (status != enclave_op_success ==> tap_storage_tag == old(tap_storage_tag));

  //----------------------------------------------------------------------//
  // Modifies statements                                                  //
  //----------------------------------------------------------------------//
  modifies tap_storage_mem;
  modifies tap_storage_addr_valid;
  modifies tap_storage_key;
  modifies tap_storage_tag;
{
  var mem : storage_mem_t;
  var valid : vaddr2bool_t;
  var key : key_t;
  var tag : tag_t;
  var prev_tag : tag_t;

  status = enclave_op_success;

  if (cpu_enclave_id != tap_null_enc_id) {
    status = enclave_op_failed;
  } else {
    // Adversary cannot forge ciphertext encrypted with the same key,
    // hence havocking and assuming that the key is different
    assume (key == null_key_t ||
            (key != tap_kms_key[eid] &&
              key != tap_enclave_metadata_key[eid]));

    // The written blob is tagged consistently with its content, and with a tag
    // that the enclave will not accept now nor after its next store.
    havoc prev_tag;
    tag = chain(prev_tag, mem, valid);
    assume (tag != tap_kms_tag[eid] &&
            tag_prev(tag) != tap_kms_tag[eid] &&
            tag != tap_enclave_metadata_tag[eid] &&
            tag_prev(tag) != tap_enclave_metadata_tag[eid]);

    tap_storage_mem[eid] = mem;
    tap_storage_addr_valid[eid] = valid;
    tap_storage_key[eid] = key;
    tap_storage_tag[eid] = tag;
  }
}
}