// The adversary fetching its own enclave's key and tag from the KMS.  This is
// a *granular* step: the adversary can stop here, so the model exposes the
// window between fetching a key and using it.
module tap {
  procedure [inline] IntegrityAdversarialStep(
      /* mode       */ mode       : mode_t,
      /* EuT        */ eid        : tap_enclave_id_t,
      /* Adversary  */ r_eid      : tap_enclave_id_t,
      /* Parent     */ r_parent_eid : tap_enclave_id_t,
      /* args       */ r_regs     : regs_t,
      /* operation  */ op         : tap_proof_op_t,
      /* dead       */ dead       : boolean
  )
    returns (next_mode : mode_t, enclave_dead : boolean, status : enclave_op_result_t)
    modifies tap_enclave_metadata_key;
    modifies tap_enclave_metadata_tag;
  {
    var abort : boolean;

    // the "default" value which may be overwritten by enter/resume
    next_mode = mode;
    // the "default" value which may be overwritten by destroy.
    enclave_dead = dead;

    assume (op == tap_proof_op_get_key_and_tag);

    call (status, abort) = get_key_and_tag();
    next_mode = mode_untrusted;
  }

  //======================================================================//
  // Transition relation                                                  //
  //======================================================================//
  next {
    assume (tap_current_mode == mode_untrusted);
    call (tap_current_mode', tap_enclave_dead', tap_op_status') =
      IntegrityAdversarialStep(tap_current_mode, tap_eid, tap_r_eid, tap_r_parent_eid, tap_r_regs, tap_r_proof_op, tap_enclave_dead);
  }
}