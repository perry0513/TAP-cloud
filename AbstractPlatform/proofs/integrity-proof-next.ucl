module integrity_proof {
  // Assume that the attacker has access to only user side operations.
  axiom tap_proof_op_valid(r_proof_op);

  // Assume that the enclave has access to only enclave operations.
  axiom tap_proof_op_valid_in_enclave(e_proof_op);

  //=============================================================================//
  // Transition relation                                                         //
  //=============================================================================//
  next {
    // Always verify the next block
    assume (verif);
    // Assume all variables are the same as the first trace
    assume (enclave_dead == enclave_dead_1);
    assume (enclave_abort == enclave_abort_1);
    assume (current_mode == current_mode_1);
    assume (kms_tampered == kms_tampered_1);
    assume (storage_tampered == storage_tampered_1);

    //---------------------------------------------------------------------------//
    // The enclave's program.                                                     //
    //                                                                            //
    // These constrain the *enclave*, not the adversary: they say which            //
    // instruction the enclave program issues next, and they are the operational   //
    // form of the session grammar                                                 //
    //                                                                            //
    //     getKeyTag . loadPS . ( compute* . storePS . updateTag )*                //
    //                                                                            //
    // with the leading loadPS omitted when nothing has been committed yet.  The   //
    // `!key_fetched` conjunct is load-bearing: re-reading the KMS tag in the       //
    // middle of a session would abandon a pending store without a crash, which is  //
    // the crash-free variant of the tag-reuse attack.                             //
    //---------------------------------------------------------------------------//
    assume (e_proof_op == tap_proof_op_get_key_and_tag ==>
              (phase == ph_syncing && !key_fetched));
    assume (e_proof_op == tap_proof_op_load_storage ==>
              (phase == ph_syncing && key_fetched && already_stored()));
    assume (e_proof_op == tap_proof_op_compute ==> (phase == ph_active));
    assume (e_proof_op == tap_proof_op_store_storage ==> (phase == ph_active));
    assume (e_proof_op == tap_proof_op_update_tag ==> (phase == ph_pending));

    // When enclave is in the abort state, it can only perform exit and no other operations.
    assume (enclave_abort ==> (e_proof_op == tap_proof_op_exit || e_proof_op == tap_proof_op_pause));

    // Step tap trace 1
    next(cpu_1);

    //---------------------------------------------------------------------------//
    // The reference trace discards uncommitted work at a destroy.                 //
    //                                                                            //
    // Un-fusing storePS from updateTag means the enclave can die holding a        //
    // ciphertext it never committed.  Trace 1 keeps that ciphertext -- whether it  //
    // survives is the adversary's choice, and that choice is the attack we are     //
    // checking.  Trace 2 is the reference: it tracks the committed history, and a  //
    // write that can no longer be committed is not part of that history, so it     //
    // goes back to the last committed ciphertext.  This discards trace 2's *own*  //
    // uncommitted write; it is not an adversary action on it.                       //
    //                                                                            //
    // The restore is a replay of the tag the KMS holds: with content-binding tags
    // that tag names the committed ciphertext, so "go back to the last committed
    // state" is directly expressible.  At rank 0 nothing has been committed, the
    // replay finds no such tag and fails, and that is harmless because with
    // nothing committed the enclave never loads.
    //---------------------------------------------------------------------------//
    if (current_mode == mode_untrusted &&
        r_proof_op == tap_proof_op_destroy &&
        r_eid == eid && phase == ph_pending &&
        status_1' == enclave_op_success) {
      call (discard_status') = cpu_2.replay_storage(eid, cpu_2.tap_kms_tag[eid]);
    }

    //---------------------------------------------------------------------------//
    // Step tap trace 2 if one of the following conditions hold:                   //
    // 1) The current mode changes (i.e., switch between trusted and untrusted)    //
    // 2) The current mode is trusted/enclave, and the enclave does not abort      //
    // 3) The enclave `eid` is launched or destroyed                               //
    // 4) The adversary rolls back an *uncommitted* ciphertext.                    //
    //                                                                            //
    // (4) is new, and it is what un-fusing the store from the commit forces.      //
    // Discarding work that was never committed is not an attack: it is what a     //
    // crash does, and the reference trace has to discard it too.  If it did not,  //
    // the reference would come back from a relaunch holding a ciphertext whose    //
    // tag the KMS has never heard of, and its own load would abort.  Note this is  //
    // attack -- still leaves the reference trace alone, and is caught.            //
    // Otherwise, stutter.                                                         //
    //---------------------------------------------------------------------------//
    if ((current_mode != current_mode_1') ||
        (current_mode == mode_enclave && !enclave_abort_1') ||
        (enclave_dead != enclave_dead_1') ||
        false) {
        next(cpu_2);
    }

    // Set the shared mode and enclave `eid` state
    current_mode' = current_mode_1';
    enclave_dead' = enclave_dead_1';

    enclave_abort' = enclave_abort_1';
    kms_tampered' = kms_tampered_1';
    storage_tampered' = storage_tampered_1';
    status' = status_1';

    // `already_stored`, `kms_key_deleted`, `kms_storage_key_sync` and
    // `kms_storage_tag_sync` need no update here: they are macros over trace 1's
    // state (see integrity-proof.ucl) and so track it automatically.

    //---------------------------------------------------------------------------//
    // Phase automaton                                                            //
    //                                                                            //
    // launch                    -> ph_syncing, key not yet fetched               //
    // getKeyTag                 -> ph_syncing, or ph_active when nothing has ever //
    //                              been committed (there is nothing to load)      //
    // loadPS                    -> ph_active                                      //
    // storePS                   -> ph_pending, a commit is now owed               //
    // updateTag                 -> ph_active, the commit landed                   //
    // destroy                   -> ph_dead                                        //
    //                                                                            //
    //---------------------------------------------------------------------------//
    phase' =
      if (enc_step_ok(status_1', enclave_abort_1', current_mode) &&
          e_proof_op == tap_proof_op_get_key_and_tag)
        then (if (valid_tag(cpu_1.tap_kms_tag[eid])) then ph_syncing else ph_active)
      else if (enc_step_ok(status_1', enclave_abort_1', current_mode) &&
               e_proof_op == tap_proof_op_load_storage)
        then ph_active
      else if (enc_step_ok(status_1', enclave_abort_1', current_mode) &&
               e_proof_op == tap_proof_op_store_storage)
        then ph_pending
      else if (enc_step_ok(status_1', enclave_abort_1', current_mode) &&
               e_proof_op == tap_proof_op_update_tag)
        then ph_active
      else if (adv_step_ok(status_1', current_mode, r_eid, eid) &&
               r_proof_op == tap_proof_op_launch)
        then ph_syncing
      else if (adv_step_ok(status_1', current_mode, r_eid, eid) &&
               r_proof_op == tap_proof_op_destroy)
        then ph_dead
      else phase;

    key_fetched' =
      if (enc_step_ok(status_1', enclave_abort_1', current_mode) &&
          e_proof_op == tap_proof_op_get_key_and_tag)
        then true
      else if (adv_step_ok(status_1', current_mode, r_eid, eid) &&
               (r_proof_op == tap_proof_op_launch || r_proof_op == tap_proof_op_destroy))
        then false
      else key_fetched;

  }
}
