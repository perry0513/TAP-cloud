module proof_common {

type * = ap_types.*;
const * = ap_types.*;
function * = ap_types.*;
define * = ap_types.*;

// The phase of the enclave's session, i.e. where the enclave has got to in the
// program `getKeyTag . loadPS . (compute* . storePS . updateTag)*`.
//
//   ph_syncing  -- relaunched, has not yet re-established its committed state
//   ph_active   -- holds the committed state (possibly plus local computation)
//   ph_pending  -- has written a ciphertext that is not yet committed
//   ph_dead     -- destroyed
//
// This is the operational counterpart of the labelling function: `ph_syncing`
// steps are the ones the labelling sends to bottom, `ph_active` steps carry
// (x, y), and the transition out of `ph_pending` is the commit that increments
// x.
type phase_t = enum { ph_syncing, ph_active, ph_pending, ph_dead };

// The adversary's instruction set.  The adversary drives the platform *and*
// may run enclaves of its own: `enter(r_eid)` with `r_eid != eid` succeeds and
// leaves `cpu_enclave_id == r_eid` while the proof stays in `mode_untrusted`.
// So every operation an enclave can execute has to be available here too --
// including `get_key_and_tag` and `update_tag`, which are separate steps from
// storePS and loadPS rather than fused into them.
define tap_proof_op_valid(o : tap_proof_op_t) : boolean
= (o == tap_proof_op_compute)   ||
  (o == tap_proof_op_destroy)   || (o == tap_proof_op_enter)     ||
  (o == tap_proof_op_exit)      || (o == tap_proof_op_launch)    ||
  (o == tap_proof_op_resume)    || (o == tap_proof_op_pause)     ||
  (o == tap_proof_op_create_key) || (o == tap_proof_op_delete_key)  ||
  (o == tap_proof_op_load_storage) || (o == tap_proof_op_store_storage) ||
  (o == tap_proof_op_get_key_and_tag) || (o == tap_proof_op_update_tag) ||
  (o == tap_proof_op_tamper_storage) ||
  (o == tap_proof_op_replay_storage) ||
  (o == tap_proof_op_release)   || (o == tap_proof_op_block);

// The enclave's own instruction set.  `store_storage` and `load_storage` now
// name the *granular* operations (encrypt-and-write, read-and-decrypt); the
// calls into the KMS are separate steps, so the window between writing a
// ciphertext and committing its tag is part of the model rather than assumed
// away.
define tap_proof_op_valid_in_enclave(o : tap_proof_op_t) : boolean
= (o == tap_proof_op_compute)   ||
  (o == tap_proof_op_pause)     ||
  (o == tap_proof_op_load_storage) ||
  (o == tap_proof_op_store_storage) ||
  (o == tap_proof_op_get_key_and_tag) ||
  (o == tap_proof_op_update_tag) ||
  (o == tap_proof_op_exit);

}
